# ==============================================================================
# DOERA AI — Frontend Environment Variables (Vercel)
# ==============================================================================

# Backend API Base URL (Render Web Service HTTPS URL)
# Example: https://doera-ai-backend.onrender.com
VITE_API_URL=https://your-backend.onrender.com

# WebSocket Server URL (Optional: auto-derived to wss:// from VITE_API_URL if omitted)
# Example: wss://doera-ai-backend.onrender.com
VITE_WS_URL=wss://your-backend.onrender.com

# Google OAuth 2.0 Client ID (from Google Cloud Console)
# Used for Google One-Tap and popup sign-in
VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
