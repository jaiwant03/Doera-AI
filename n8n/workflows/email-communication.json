{
  "name": "DOERA AI - 02 - Email Communication",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "email-communication",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "node-email-webhook",
      "name": "Webhook - Send Email",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [240, 300]
    },
    {
      "parameters": {
        "fromEmail": "assistant@doera.ai",
        "toEmail": "={{ $json.body.to }}",
        "subject": "={{ $json.body.subject }}",
        "html": "={{ $json.body.htmlBody }}",
        "options": {}
      },
      "id": "node-send-email",
      "name": "Send Email",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2.1,
      "position": [480, 300]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={\n  \"success\": true,\n  \"messageId\": \"msg-{{ $now.toMillis() }}\",\n  \"status\": \"SENT\",\n  \"to\": \"{{ $('Webhook - Send Email').item.json.body.to }}\"\n}",
        "options": {
          "responseCode": 200
        }
      },
      "id": "node-respond-email-success",
      "name": "Respond OK",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [720, 300]
    }
  ],
  "connections": {
    "Webhook - Send Email": {
      "main": [
        [
          {
            "node": "Send Email",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Send Email": {
      "main": [
        [
          {
            "node": "Respond OK",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": true,
  "settings": {
    "executionOrder": "v1"
  }
}
