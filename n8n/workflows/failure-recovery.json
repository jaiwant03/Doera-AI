{
  "name": "DOERA AI - 06 - Failure Recovery",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "task-failure-recovery",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "node-failure-webhook",
      "name": "Webhook - Task Failure Event",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [240, 300]
    },
    {
      "parameters": {
        "values": {
          "string": [
            {
              "name": "taskId",
              "value": "={{ $json.body.taskId }}"
            },
            {
              "name": "error",
              "value": "={{ $json.body.error }}"
            }
          ]
        },
        "options": {}
      },
      "id": "node-diagnose-failure",
      "name": "Diagnose Failure",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [480, 300]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={\n  \"recoveryInitiated\": true,\n  \"taskId\": \"{{ $json.taskId }}\",\n  \"status\": \"RECOVERING\"\n}",
        "options": {
          "responseCode": 200
        }
      },
      "id": "node-respond-recovery",
      "name": "Respond Recovery Plan",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [720, 300]
    }
  ],
  "connections": {
    "Webhook - Task Failure Event": {
      "main": [
        [
          {
            "node": "Diagnose Failure",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Diagnose Failure": {
      "main": [
        [
          {
            "node": "Respond Recovery Plan",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": true,
  "settings": {
    "executionOrder": "v1"
  }
}
