{
  "name": "DOERA AI - 01 - Task Execution Trigger",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "task-trigger",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "node-webhook-trigger",
      "name": "Webhook - Task Execution Trigger",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [240, 300]
    },
    {
      "parameters": {
        "values": {
          "string": [
            {
              "name": "taskId",
              "value": "={{ $json.body.taskId }}"
            },
            {
              "name": "userRequest",
              "value": "={{ $json.body.userRequest }}"
            },
            {
              "name": "category",
              "value": "={{ $json.body.category }}"
            }
          ]
        },
        "options": {}
      },
      "id": "node-parse-task",
      "name": "Parse Task Context",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [480, 300]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={\n  \"success\": true,\n  \"message\": \"Task execution registered by n8n.\",\n  \"taskId\": \"{{ $json.taskId }}\",\n  \"status\": \"REGISTERED\",\n  \"timestamp\": \"{{ $now.toISO() }}\"\n}",
        "options": {
          "responseCode": 200
        }
      },
      "id": "node-respond-success",
      "name": "Respond 200 OK",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [720, 300]
    }
  ],
  "connections": {
    "Webhook - Task Execution Trigger": {
      "main": [
        [
          {
            "node": "Parse Task Context",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Parse Task Context": {
      "main": [
        [
          {
            "node": "Respond 200 OK",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": true,
  "settings": {
    "executionOrder": "v1"
  }
}
