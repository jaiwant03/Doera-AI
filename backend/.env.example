# ==============================================================================
# DOERA AI — Backend Production Environment (Independent Deployment)
# ==============================================================================
# Server & Environment
PORT=5000
NODE_ENV=production
CLIENT_URL=https://your-frontend-domain.com

# Database (MongoDB Atlas or standalone instance)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/doera-ai?retryWrites=true&w=majority

# Security & Encryption Secrets (Provide random 32+ character secrets)
JWT_SECRET=your_super_secure_jwt_secret_32chars_min!
ENCRYPTION_KEY=your_32_bytes_super_secure_key_0123
EMAIL_ENCRYPTION_KEY=your_email_encryption_key_32chars!

# Cloud AI LLM Provider (Optional - Groq / OpenAI Cloud API)
# Uses ultra-fast cloud LLaMA 3.3 via Groq (free tier) or OpenAI. If blank, built-in intelligent planner runs automatically.
LLM_PROVIDER=groq
GROQ_API_KEY=
OPENAI_API_KEY=

# Optional: External n8n Automation Webhooks (NO API KEY REQUIRED)
# Provide your external n8n webhook URL, or leave blank to run 100% natively in Node.js
N8N_WEBHOOK_URL=

# External Google Integrations (Optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://your-backend-domain.com/api/integrations/google/callback
GOOGLE_PLACES_API_KEY=

# Meta WhatsApp Cloud API (Optional)
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=

# Optional Caching
REDIS_URL=
