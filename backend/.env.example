# ==============================================================================
# DOERA AI — Backend Production Environment Configuration
# ==============================================================================

# Server & Hosting (Render binds automatically via process.env.PORT)
PORT=5000
NODE_ENV=production
FRONTEND_URL=https://your-frontend.vercel.app
CLIENT_URL=https://your-frontend.vercel.app

# Database (MongoDB Atlas)
# Format: mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/doera-ai?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<db_user>:<db_password>@cluster0.xxxxx.mongodb.net/doera-ai?retryWrites=true&w=majority

# Security & Token Generation (Generate 32+ character random strings)
JWT_SECRET=replace_with_a_secure_random_32_plus_character_secret_key_here!
ENCRYPTION_KEY=replace_with_a_secure_32_byte_hex_or_string_key_0123456789
EMAIL_ENCRYPTION_KEY=replace_with_a_secure_32_byte_email_encryption_key_here!

# AI LLM Provider (Groq / OpenAI / Gemini / Built-in Rule Planner)
# Free cloud LLaMA 3.3 70B via Groq is default; falls back to built-in rule planner if empty
LLM_PROVIDER=groq
GROQ_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# Google OAuth & Sign-In (Configured in Google Cloud Console)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=https://your-backend.onrender.com/api/integrations/google/callback
GOOGLE_CALLBACK_URL=https://your-backend.onrender.com/api/integrations/google/callback
GMAIL_OAUTH_REDIRECT_URI=https://your-backend.onrender.com/api/integrations/google/callback

# Google Places API (Optional - For Local Service Research enhancement)
GOOGLE_PLACES_API_KEY=

# External Self-Hosted n8n Automation Engine (DO NOT DEPLOY TO VERCEL OR RENDER)
# Hosted separately (e.g., VPS, Docker on home server, Cloudflare Tunnel, ngrok)
# Render backend triggers your external n8n workflows via HTTPS webhooks.
N8N_ENABLED=true
N8N_BASE_URL=https://n8n.your-custom-domain.com
N8N_WEBHOOK_URL=https://n8n.your-custom-domain.com/webhook/doera-actions

# Meta WhatsApp Cloud API (Optional)
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=doera_whatsapp_verify_token_2026

# Payment Providers (Optional - Stripe & Razorpay)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
