    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "googleapis": "^144.0.0",
    "groq-sdk": "^0.15.0",
    "helmet": "^8.3.0",
    "ioredis": "^6.0.0",
    "jsonwebtoken": "^9.0.2",
    "mammoth": "^1.13.0",
    "mongoose": "^8.9.5",
    "nodemailer": "^6.9.16",
    "pdf-parse": "^2.4.5",
    "playwright": "^1.49.1",
    "sharp": "^0.35.5",
    "tesseract.js": "^7.0.0",
    "uuid": "^11.0.5",
    "ws": "^8.18.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "jest": "^29.7.0",
